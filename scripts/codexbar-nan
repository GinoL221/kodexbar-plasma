#!/usr/bin/env python3
"""Wrap the codexbar CLI and add a NaN Cloud usage entry to `usage` JSON output.

Point the plasmoid's "CodexBar command" setting at this script. Every other
invocation is passed through to the real codexbar untouched.

The NaN entry follows the codexbar usage contract (provider/source/usage windows),
so the plasmoid renders it like any other provider. See docs/nan-adapter.md.
"""

import glob
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import urllib.error
import urllib.request
from datetime import datetime, timedelta, timezone

DEFAULT_BASE_URL = "https://api.nan.builders"
DEFAULT_RENEWAL_DAY = 3
DEFAULT_MODELS = [
    {"id": "deepseek-v4-flash", "label": "DS V4", "quota": 1_000_000_000},
    {"id": "glm5.3-flash", "label": "GLM", "quota": 500_000_000},
]
DEFAULT_MODEL_PRICING = {
    "deepseek-v4-flash": {"input": 0.27, "cached": 0.07, "output": 1.10},
    "glm5.3-flash": {"input": 0.10, "cached": 0.025, "output": 0.40},
}
DEFAULT_FALLBACK_PRICING = {"input": 0.15, "cached": 0.04, "output": 0.60}
WINDOW_KEYS = ("primary", "secondary", "tertiary")
MONTHS = ("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
ANTIGRAVITY_DB_ROOTS = (
    os.path.join(".gemini", "antigravity-cli", "conversations"),
    os.path.join(".gemini", "antigravity"),
    os.path.join(".gemini", "antigravity", "conversations"),
)
DEFAULT_ANTIGRAVITY_DB_LIMIT = 500
DEFAULT_ANTIGRAVITY_DB_CAP = 450
DEFAULT_ANTIGRAVITY_WINDOW_DAYS = 45


class NanError(Exception):
    def __init__(self, kind, message):
        super().__init__(message)
        self.kind = kind
        self.message = message


def config_dir():
    return os.path.join(os.path.expanduser("~"), ".config", "codexbar")


def utc_now():
    override = os.environ.get("NAN_NOW")
    if override:
        return datetime.strptime(override, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    return datetime.now(timezone.utc)


def shift_month(year, month, delta):
    index = year * 12 + (month - 1) + delta
    return index // 12, index % 12 + 1


def renewal_moment(year, month, day):
    last_day = (datetime(*shift_month(year, month, 1), 1, tzinfo=timezone.utc) - timedelta(days=1)).day
    return datetime(year, month, min(day, last_day), tzinfo=timezone.utc)


def billing_period(now, renewal_day):
    this_month = renewal_moment(now.year, now.month, renewal_day)
    if now >= this_month:
        start = this_month
        end = renewal_moment(*shift_month(now.year, now.month, 1), renewal_day)
    else:
        start = renewal_moment(*shift_month(now.year, now.month, -1), renewal_day)
        end = this_month
    return start, end


def load_models_config():
    path = os.path.join(config_dir(), "nan.json")
    if not os.path.exists(path):
        return DEFAULT_MODELS, DEFAULT_RENEWAL_DAY
    try:
        with open(path, encoding="utf-8") as handle:
            raw = json.load(handle)
        day = raw.get("renewalDay", DEFAULT_RENEWAL_DAY)
        models = raw.get("models", DEFAULT_MODELS)
        if isinstance(day, bool) or not isinstance(day, int) or not 1 <= day <= 31:
            raise ValueError("renewalDay must be an integer from 1 to 31")
        if not isinstance(models, list) or not 1 <= len(models) <= len(WINDOW_KEYS):
            raise ValueError("models must list 1 to 3 entries")
        for model in models:
            quota = model.get("quota") if isinstance(model, dict) else None
            if not isinstance(model.get("id"), str) or not isinstance(model.get("label"), str):
                raise ValueError("each model needs string id and label")
            if isinstance(quota, bool) or not isinstance(quota, int) or quota <= 0:
                raise ValueError("each model needs a positive integer quota")
    except (OSError, ValueError, AttributeError, TypeError) as error:
        raise NanError("config", "Invalid %s: %s" % (path, error))
    return models, day


def resolve_pi_nan_key():
    try:
        auth_path = os.path.join(os.path.expanduser("~"), ".pi", "agent", "auth.json")
        with open(auth_path, encoding="utf-8") as handle:
            data = json.load(handle)
        nan_entry = data.get("nan") if isinstance(data, dict) else None
        key = nan_entry.get("key") if isinstance(nan_entry, dict) else None
        return key.strip() if isinstance(key, str) else ""
    except Exception:
        return ""


def resolve_api_key():
    key = os.environ.get("NAN_API_KEY", "").strip()
    if key:
        return key
    path = os.environ.get("NAN_API_KEY_FILE") or os.path.join(config_dir(), "nan-api-key")
    try:
        mode = os.stat(path).st_mode
    except OSError:
        pi_key = resolve_pi_nan_key()
        if pi_key:
            return pi_key
        raise NanError("config", "NAN_API_KEY is not set and no key file was found at %s" % path)
    if mode & 0o077:
        raise NanError("config", "Key file %s is readable by other users; run chmod 600 on it" % path)
    with open(path, encoding="utf-8") as handle:
        key = handle.read().strip()
    if not key:
        raise NanError("config", "Key file %s is empty" % path)
    return key


def fetch_usage(key, start):
    base_url = os.environ.get("NAN_API_BASE_URL", DEFAULT_BASE_URL).rstrip("/")
    url = "%s/v1/usage?start_date=%s" % (base_url, start.strftime("%Y-%m-%d"))
    request = urllib.request.Request(url, headers={"Authorization": "Bearer " + key})
    timeout = float(os.environ.get("NAN_TIMEOUT", "8"))
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        raise NanError("provider", "NaN Cloud API returned HTTP %d" % error.code)
    except (urllib.error.URLError, OSError) as error:
        raise NanError("runtime", "Could not reach NaN Cloud: %s" % getattr(error, "reason", error))
    except ValueError:
        raise NanError("runtime", "NaN Cloud returned an invalid usage report")


def build_entry(report, models, start, end, now):
    start_day = start.strftime("%Y-%m-%d")
    end_day = end.strftime("%Y-%m-%d")
    tokens = {model["id"]: 0 for model in models}
    rows = report.get("data") if isinstance(report, dict) else None
    for row in rows if isinstance(rows, list) else []:
        if not isinstance(row, dict):
            continue
        used = row.get("total_tokens")
        if row.get("model") in tokens and isinstance(used, int) and start_day <= str(row.get("date")) < end_day:
            tokens[row["model"]] += used

    window_minutes = int((end - start).total_seconds() // 60)
    usage = {
        "identity": {"providerID": "nan", "loginMethod": "Gentle"},
        "updatedAt": now.strftime("%Y-%m-%dT%H:%M:%SZ"),
    }
    labels = {}
    for key, model in zip(WINDOW_KEYS, models):
        labels[key] = model["label"]
        usage[key] = {
            "usedPercent": round(tokens[model["id"]] / model["quota"] * 100, 2),
            "windowMinutes": window_minutes,
            "resetsAt": end.strftime("%Y-%m-%dT%H:%M:%SZ"),
            "resetDescription": "%s %d" % (MONTHS[end.month - 1], end.day),
        }
    return {"provider": "nan", "source": "api", "rateWindowLabels": labels, "usage": usage}


def error_entry(error):
    return {
        "provider": "nan",
        "source": "api",
        "error": {"kind": error.kind, "code": 1, "message": error.message},
    }


def fetch_usage_with_fallback(start):
    key = resolve_api_key()
    try:
        return fetch_usage(key, start)
    except NanError as error:
        pi_key = resolve_pi_nan_key() if "HTTP 401" in error.message else ""
        if pi_key and pi_key != key:
            return fetch_usage(pi_key, start)
        raise


def estimate_row_cost_usd(row):
    credits_val = row.get("credits")
    if isinstance(credits_val, (int, float)) and not isinstance(credits_val, bool) and credits_val > 0:
        return float(credits_val)
    rates = DEFAULT_MODEL_PRICING.get(row.get("model"), DEFAULT_FALLBACK_PRICING)
    total_tokens = row.get("total_tokens")
    prompt = row.get("prompt_tokens")
    cached = row.get("cached_tokens", 0)
    completion = row.get("completion_tokens")
    if isinstance(prompt, int) and not isinstance(prompt, bool) and isinstance(completion, int) and not isinstance(completion, bool):
        cached_val = cached if isinstance(cached, int) and not isinstance(cached, bool) and cached > 0 else 0
        uncached = max(0, prompt - cached_val)
        return (uncached * rates["input"] + cached_val * rates["cached"] + max(0, completion) * rates["output"]) / 1_000_000.0
    return (max(0, total_tokens) * rates["input"]) / 1_000_000.0


def collect_nan_entry():
    try:
        models, renewal_day = load_models_config()
        now = utc_now()
        start, end = billing_period(now, renewal_day)
        report = fetch_usage_with_fallback(start)
        return build_entry(report, models, start, end, now)
    except NanError as error:
        return error_entry(error)
    except Exception as error:  # never let NaN break the other providers
        return error_entry(NanError("runtime", "NaN adapter failed: %s" % error))


def collect_nan_cost_entry():
    try:
        now = utc_now()
        start = (now - timedelta(days=29)).replace(hour=0, minute=0, second=0, microsecond=0)
        start_day = start.strftime("%Y-%m-%d")
        today_str = now.strftime("%Y-%m-%d")
        report = fetch_usage_with_fallback(start)
        rows = report.get("data") if isinstance(report, dict) else None
        by_day = {}
        for row in rows if isinstance(rows, list) else []:
            if not isinstance(row, dict):
                continue
            date = row.get("date")
            model = row.get("model")
            total_tokens = row.get("total_tokens")
            if (
                not isinstance(date, str)
                or not re.match(r"^\d{4}-\d{2}-\d{2}$", date)
                or not (start_day <= date <= today_str)
                or not isinstance(model, str)
                or not model
                or isinstance(total_tokens, bool)
                or not isinstance(total_tokens, int)
                or total_tokens < 0
            ):
                continue
            cost_usd = estimate_row_cost_usd(row)
            day_bucket = by_day.setdefault(date, {"tokens": 0, "cost": 0.0, "models": {}})
            day_bucket["tokens"] += total_tokens
            day_bucket["cost"] += cost_usd
            model_bucket = day_bucket["models"].setdefault(model, {"tokens": 0, "cost": 0.0})
            model_bucket["tokens"] += total_tokens
            model_bucket["cost"] += cost_usd

        daily = []
        total_cost = 0.0
        total_tokens_sum = 0
        for date in sorted(by_day.keys()):
            day_bucket = by_day[date]
            breakdowns = [
                {
                    "modelName": model_name,
                    "cost": round(mb["cost"], 6),
                    "totalTokens": mb["tokens"],
                }
                for model_name, mb in day_bucket["models"].items()
            ]
            day_cost = round(day_bucket["cost"], 6)
            daily.append(
                {
                    "date": date,
                    "totalCost": day_cost,
                    "totalTokens": day_bucket["tokens"],
                    "modelBreakdowns": breakdowns,
                }
            )
            total_cost += day_bucket["cost"]
            total_tokens_sum += day_bucket["tokens"]

        today_entry = next((item for item in daily if item["date"] == today_str), None)
        session_entry = today_entry if today_entry is not None else (daily[-1] if daily else None)
        return {
            "provider": "nan",
            "source": "local",
            "sessionCostUSD": session_entry["totalCost"] if session_entry else 0.0,
            "sessionTokens": session_entry["totalTokens"] if session_entry else 0,
            "last30DaysCostUSD": round(total_cost, 6),
            "last30DaysTokens": total_tokens_sum,
            "daily": daily,
        }
    except NanError as error:
        return error_entry(error)
    except Exception as error:  # never let NaN break the other providers
        return error_entry(NanError("runtime", "NaN cost adapter failed: %s" % error))


def find_real_codexbar():
    override = os.environ.get("CODEXBAR_REAL")
    if override:
        return override
    me = os.path.realpath(__file__)
    candidates = [shutil.which("codexbar")] + [
        os.path.join(os.path.expanduser("~"), ".local", "bin", "codexbar"),
        "/usr/local/bin/codexbar",
        "/usr/bin/codexbar",
    ]
    for candidate in candidates:
        if candidate and os.access(candidate, os.X_OK) and os.path.realpath(candidate) != me:
            return candidate
    return None


def option_value(args, name):
    for index, arg in enumerate(args):
        if arg == name and index + 1 < len(args):
            return args[index + 1]
        if arg.startswith(name + "="):
            return arg.split("=", 1)[1]
    return None


def wants_json(args):
    return "--json" in args or "--json-only" in args or option_value(args, "--format") == "json"


def maybe_refresh_claude_oauth():
    try:
        cred_path = os.path.join(os.path.expanduser("~"), ".claude", ".credentials.json")
        if not os.path.isfile(cred_path):
            return
        with open(cred_path, encoding="utf-8") as handle:
            cred = json.load(handle)
        oauth = cred.get("claudeAiOauth") if isinstance(cred, dict) else None
        if not isinstance(oauth, dict) or not oauth.get("refreshToken"):
            return
        expires_at = oauth.get("expiresAt")
        if not isinstance(expires_at, (int, float)) or expires_at > int(utc_now().timestamp() * 1000):
            return
        claude_bin = (
            os.environ.get("CLAUDE_BIN")
            or shutil.which("claude")
            or os.path.join(os.path.expanduser("~"), ".local", "bin", "claude")
        )
        if claude_bin and os.access(claude_bin, os.X_OK):
            subprocess.run(
                [claude_bin, "auth", "status"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=5,
            )
    except Exception:
        pass


def _read_json_dict(path):
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
        return data if isinstance(data, dict) else None
    except Exception:
        return None


AGY_LOG_EMAIL_PATTERN = re.compile(
    r"(?:applyAuthResult:\s*email=|OAuth:\s*authenticated successfully as )([^\s,]+)"
)


def _extract_agy_log_email(path):
    try:
        with open(path, encoding="utf-8", errors="ignore") as handle:
            matches = AGY_LOG_EMAIL_PATTERN.findall(handle.read())
        for candidate in reversed(matches):
            email = candidate.strip()
            if "@" in email:
                return email
    except Exception:
        return None
    return None


def resolve_antigravity_email():
    """Return the active Antigravity CLI email from agy logs, OAuth file, or cli-proxy-api."""
    home = os.path.expanduser("~")
    agy_dir = os.path.join(home, ".gemini", "antigravity-cli")

    email = _extract_agy_log_email(os.path.join(agy_dir, "cli.log"))
    if email:
        return email

    try:
        log_pattern = os.path.join(agy_dir, "log", "cli-*.log")
        for path in sorted(glob.glob(log_pattern), reverse=True)[:10]:
            email = _extract_agy_log_email(path)
            if email:
                return email
    except Exception:
        pass

    agy_token = _read_json_dict(os.path.join(agy_dir, "antigravity-oauth-token"))
    if agy_token:
        email = agy_token.get("id_token_email")
        if isinstance(email, str) and email.strip():
            return email.strip()

    try:
        pattern = os.path.join(home, ".cli-proxy-api", "antigravity-*.json")
        for path in sorted(glob.glob(pattern)):
            data = _read_json_dict(path)
            if data and not bool(data.get("disabled", False)):
                email = data.get("email")
                if isinstance(email, str) and email.strip():
                    return email.strip()
    except Exception:
        return None
    return None


def resolve_claude_email():
    """Return the local Claude account email from ~/.claude.json, if present."""
    data = _read_json_dict(os.path.join(os.path.expanduser("~"), ".claude.json"))
    oauth = data.get("oauthAccount") if data else None
    email = oauth.get("emailAddress") if isinstance(oauth, dict) else None
    if isinstance(email, str) and email.strip():
        return email.strip()
    return None


EMAIL_RESOLVERS = {
    "antigravity": resolve_antigravity_email,
    "claude": resolve_claude_email,
}


def has_codex_cli_auth():
    """Return True when ~/.codex/auth.json (or $CODEX_HOME/auth.json) holds an active CLI session."""
    codex_home = os.environ.get("CODEX_HOME") or os.path.join(os.path.expanduser("~"), ".codex")
    data = _read_json_dict(os.path.join(codex_home, "auth.json"))
    if not isinstance(data, dict):
        return False
    api_key = data.get("OPENAI_API_KEY")
    if isinstance(api_key, str) and api_key.strip():
        return True
    tokens = data.get("tokens")
    if isinstance(tokens, dict):
        for key in ("access_token", "refresh_token", "id_token"):
            value = tokens.get(key)
            if isinstance(value, str) and value.strip():
                return True
    return False


def has_claude_cli_auth():
    """Return True when ~/.claude/.credentials.json or ~/.claude.json holds an active Claude session."""
    home = os.path.expanduser("~")
    cred = _read_json_dict(os.path.join(home, ".claude", ".credentials.json"))
    oauth = cred.get("claudeAiOauth") if isinstance(cred, dict) else None
    if isinstance(oauth, dict):
        for key in ("accessToken", "refreshToken"):
            value = oauth.get(key)
            if isinstance(value, str) and value.strip():
                return True
    if resolve_claude_email() is not None:
        return True
    return False


def has_antigravity_cli_auth():
    """Return True when local Antigravity CLI token, logs, or cli-proxy-api holds an active session."""
    home = os.path.expanduser("~")
    agy_token = _read_json_dict(
        os.path.join(home, ".gemini", "antigravity-cli", "antigravity-oauth-token")
    )
    if isinstance(agy_token, dict):
        for key in ("access_token", "refresh_token", "id_token_email", "auth_method"):
            value = agy_token.get(key)
            if isinstance(value, str) and value.strip():
                return True
    if resolve_antigravity_email() is not None:
        return True
    return False


LOCAL_SESSION_CHECKS = {
    "codex": has_codex_cli_auth,
    "claude": has_claude_cli_auth,
    "antigravity": has_antigravity_cli_auth,
}


def has_provider_local_state(provider_id):
    home = os.path.expanduser("~")
    if os.path.exists(os.path.join(config_dir(), "config.json")):
        return True
    if provider_id == "codex":
        return True
    if provider_id == "claude":
        return os.path.exists(os.path.join(home, ".claude")) or os.path.exists(
            os.path.join(home, ".claude.json")
        )
    if provider_id == "antigravity":
        return os.path.exists(
            os.path.join(home, ".gemini", "antigravity-cli")
        ) or os.path.exists(os.path.join(home, ".cli-proxy-api"))
    return False


def provider_requires_local_auth(provider_id):
    """Return False only if ~/.config/codexbar/config.json explicitly sets source to web/api."""
    cfg = _read_json_dict(os.path.join(config_dir(), "config.json"))
    providers = cfg.get("providers") if isinstance(cfg, dict) else None
    if isinstance(providers, list):
        for item in providers:
            if isinstance(item, dict) and item.get("id") == provider_id:
                if item.get("source") in ("web", "api"):
                    return False
    return True


def is_provider_logged_out(provider_id):
    checker = LOCAL_SESSION_CHECKS.get(provider_id)
    if checker is None:
        return False
    if not has_provider_local_state(provider_id) or not provider_requires_local_auth(provider_id):
        return False
    return not checker()


def logged_out_provider_entry(provider_id, source="auto"):
    return {
        "provider": provider_id,
        "source": source if isinstance(source, str) and source else "auto",
        "error": {
            "kind": "provider",
            "code": 1,
            "message": "%s local CLI session is logged out" % provider_id,
        },
    }


def sanitize_logged_out_providers(entries):
    """Replace usage entries with a provider error when a local CLI provider session is logged out."""
    if not isinstance(entries, list):
        return
    for index, entry in enumerate(entries):
        if not isinstance(entry, dict) or "usage" not in entry:
            continue
        provider_id = entry.get("provider")
        if isinstance(provider_id, str) and is_provider_logged_out(provider_id):
            entries[index] = logged_out_provider_entry(provider_id, entry.get("source"))


def configured_enabled_providers(fallback_default=True):
    cfg = _read_json_dict(os.path.join(config_dir(), "config.json"))
    providers = cfg.get("providers") if isinstance(cfg, dict) else None
    enabled = []
    if isinstance(providers, list):
        for item in providers:
            if isinstance(item, dict) and item.get("enabled") is True:
                pid = item.get("id")
                if isinstance(pid, str) and pid and pid != "nan" and pid not in enabled:
                    enabled.append(pid)
    if enabled or not fallback_default:
        return enabled
    return ["codex", "claude", "antigravity", "grok", "copilot", "cursor"]


def args_with_provider(args, provider_id):
    filtered = []
    skip_next = False
    for arg in args:
        if skip_next:
            skip_next = False
            continue
        if arg == "--provider":
            skip_next = True
            continue
        if arg.startswith("--provider="):
            continue
        filtered.append(arg)
    return filtered + ["--provider", provider_id]


def run_command_with_timeout(cmd, timeout):
    proc = subprocess.Popen(
        cmd,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        cwd=tempfile.gettempdir(),
        text=True,
        start_new_session=True,
    )
    try:
        stdout, _ = proc.communicate(timeout=timeout)
        return stdout, proc.returncode
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            proc.kill()
        if proc.stdout is not None:
            proc.stdout.close()
        proc.wait()
        raise


def collect_per_provider_entries(real, args):
    try:
        provider_timeout = float(os.environ.get("CODEXBAR_PROVIDER_TIMEOUT", "20"))
    except ValueError:
        provider_timeout = 20.0
    providers = configured_enabled_providers(fallback_default=True)
    results_by_provider = {}
    threads = []

    def query_one(pid):
        try:
            raw_out, _ = run_command_with_timeout(
                [real] + args_with_provider(args, pid),
                timeout=provider_timeout,
            )
            parsed = json.loads(raw_out)
            if isinstance(parsed, list):
                results_by_provider[pid] = parsed
                return
        except subprocess.TimeoutExpired:
            results_by_provider[pid] = [
                {
                    "provider": pid,
                    "source": "auto",
                    "error": {
                        "kind": "runtime",
                        "code": 1,
                        "message": "Provider %s timed out after %ss" % (pid, provider_timeout),
                    },
                }
            ]
            return
        except Exception as error:
            results_by_provider[pid] = [
                {
                    "provider": pid,
                    "source": "auto",
                    "error": {
                        "kind": "runtime",
                        "code": 1,
                        "message": "Provider %s failed: %s" % (pid, error),
                    },
                }
            ]
            return
        results_by_provider[pid] = []

    for pid in providers:
        if is_provider_logged_out(pid):
            results_by_provider[pid] = [logged_out_provider_entry(pid)]
            continue
        thread = threading.Thread(target=query_one, args=(pid,))
        thread.start()
        threads.append(thread)

    for thread in threads:
        thread.join()

    combined = []
    for pid in providers:
        combined.extend(results_by_provider.get(pid, []))
    return combined


def enrich_provider_emails(entries):
    """Fill missing usage/identity accountEmail fields from local provider state."""
    if not isinstance(entries, list):
        return
    resolved_emails = {}
    for entry in entries:
        if not isinstance(entry, dict):
            continue
        provider_id = entry.get("provider")
        resolver = EMAIL_RESOLVERS.get(provider_id)
        if resolver is None:
            continue
        usage = entry.get("usage")
        if not isinstance(usage, dict):
            continue
        identity = usage.get("identity")
        existing = usage.get("accountEmail") or (
            identity.get("accountEmail") if isinstance(identity, dict) else None
        )
        if not existing:
            if provider_id not in resolved_emails:
                resolved_emails[provider_id] = resolver()
            email = resolved_emails[provider_id]
            if email:
                usage["accountEmail"] = email
                if isinstance(identity, dict) and not identity.get("accountEmail"):
                    identity["accountEmail"] = email


def _antigravity_db_limit():
    raw = os.environ.get("CODEXBAR_ANTIGRAVITY_DB_LIMIT", "").strip()
    if raw:
        try:
            parsed = int(raw)
            if parsed >= 2:
                return parsed
        except ValueError:
            pass
    return DEFAULT_ANTIGRAVITY_DB_LIMIT


def _antigravity_window_days(args):
    raw_days = option_value(args, "--days")
    if raw_days:
        try:
            days = int(raw_days)
            if days > 0:
                return max(DEFAULT_ANTIGRAVITY_WINDOW_DAYS, days + 15)
        except ValueError:
            pass
    return DEFAULT_ANTIGRAVITY_WINDOW_DAYS


def _collect_antigravity_dbs(home):
    entries = []
    for rel_root in ANTIGRAVITY_DB_ROOTS:
        root = os.path.join(home, rel_root)
        try:
            names = os.listdir(root)
        except OSError:
            continue
        for name in names:
            if name.startswith(".") or not name.lower().endswith(".db"):
                continue
            full_path = os.path.join(root, name)
            try:
                if not os.path.isfile(full_path):
                    continue
                mtime = os.path.getmtime(full_path)
            except OSError:
                continue
            for suffix in ("-wal", "-shm"):
                sidecar = full_path + suffix
                try:
                    sidecar_mtime = os.path.getmtime(sidecar)
                    if sidecar_mtime > mtime:
                        mtime = sidecar_mtime
                except OSError:
                    pass
            entries.append((mtime, rel_root, name, full_path))
    return entries


def _symlink_if_exists(src, dst):
    if not os.path.exists(src):
        return
    try:
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        os.symlink(src, dst)
    except OSError:
        pass


def run_antigravity_cost_with_pruned_home(real, args):
    """Work around CodexBar's hardcoded 500-DB discovery cap for Antigravity cost."""
    home = os.path.expanduser("~")
    limit = _antigravity_db_limit()
    all_dbs = _collect_antigravity_dbs(home)
    if len(all_dbs) < limit:
        return None

    cutoff = utc_now().timestamp() - _antigravity_window_days(args) * 86400
    recent = [item for item in all_dbs if item[0] >= cutoff]
    recent.sort(key=lambda item: item[0], reverse=True)
    cap = max(1, min(limit - 1, DEFAULT_ANTIGRAVITY_DB_CAP))
    selected = recent[:cap]

    with tempfile.TemporaryDirectory(prefix="codexbar-agy-home-") as tmp_home:
        for rel_path in (
            os.path.join(".config", "codexbar"),
            os.path.join(".config", "codexbar.plist"),
            os.path.join(".config", "tokscale"),
            ".cache",
            os.path.join(".local", "share", "codexbar-cli"),
        ):
            _symlink_if_exists(os.path.join(home, rel_path), os.path.join(tmp_home, rel_path))

        for _, rel_root, name, full_path in selected:
            dst_dir = os.path.join(tmp_home, rel_root)
            _symlink_if_exists(full_path, os.path.join(dst_dir, name))
            for suffix in ("-wal", "-shm"):
                _symlink_if_exists(full_path + suffix, os.path.join(dst_dir, name + suffix))

        env = dict(os.environ, HOME=tmp_home)
        completed = subprocess.run([real] + args, env=env)
        return completed.returncode


def main(args):
    real = find_real_codexbar()
    if real is None:
        sys.stderr.write("codexbar-nan: the codexbar CLI was not found; set CODEXBAR_REAL\n")
        return 127

    provider = option_value(args, "--provider")
    if bool(args) and args[0] == "cost" and wants_json(args) and provider == "nan":
        entry = collect_nan_cost_entry()
        print(json.dumps([entry]))
        return 1 if "error" in entry else 0

    if bool(args) and args[0] == "cost" and provider == "antigravity":
        pruned_rc = run_antigravity_cost_with_pruned_home(real, args)
        if pruned_rc is not None:
            return pruned_rc

    if bool(args) and args[0] == "usage" and provider in (None, "all", "claude"):
        maybe_refresh_claude_oauth()

    merges = bool(args) and args[0] == "usage" and wants_json(args) and provider in (None, "all", "nan")
    if not merges:
        os.execv(real, [real] + args)

    holder = {}
    worker = threading.Thread(target=lambda: holder.update(entry=collect_nan_entry()))
    worker.start()

    if provider == "nan":
        worker.join()
        entry = holder["entry"]
        print(json.dumps([entry]))
        return 1 if "error" in entry else 0

    try:
        cli_timeout = float(os.environ.get("CODEXBAR_CLI_TIMEOUT", "20"))
    except ValueError:
        cli_timeout = 20.0

    if configured_enabled_providers(fallback_default=False):
        entries = collect_per_provider_entries(real, args)
        raw_stdout = ""
        returncode = 0
    else:
        try:
            raw_stdout, returncode = run_command_with_timeout([real] + args, timeout=cli_timeout)
            try:
                entries = json.loads(raw_stdout)
            except ValueError:
                entries = None
        except subprocess.TimeoutExpired:
            entries = collect_per_provider_entries(real, args)
            raw_stdout = ""
            returncode = 0

    worker.join()
    if not isinstance(entries, list):
        sys.stdout.write(raw_stdout)
        return returncode
    sanitize_logged_out_providers(entries)
    enrich_provider_emails(entries)
    entries.append(holder["entry"])
    print(json.dumps(entries))
    return returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
